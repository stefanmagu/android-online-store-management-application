<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPozePisici"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="Poze cu animale" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="201dp"
            android:layout_height="128dp"
            app:srcCompat="@drawable/pisica1" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="162dp"
            android:layout_height="94dp"
            app:srcCompat="@drawable/pisica2" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="178dp"
            android:layout_height="96dp"
            app:srcCompat="@drawable/pisica3" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="152dp"
            android:layout_height="86dp"
            app:srcCompat="@drawable/pisica4" />

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="206dp"
            android:layout_height="116dp"
            app:srcCompat="@drawable/pisica5" />

        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Click me" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>